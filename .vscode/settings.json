{
    "liveServer.settings.port": 5501,
    
    // Accesibilidad: Ayuda a detectar font-size sin calc()
    "scss.lint.unknownProperties": "warning",
    
    // Mostrar advertencias para patrones problemáticos
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true
    },
    
    // Snippets personalizados para accesibilidad (ver más abajo)
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    
