            "color": "#fff",
            "backgroundColor": "#ff6347",
            "overviewRulerColor": "#ff6347"
        },
        {
            "text": "FIXME:",
            "color": "#fff",
            "backgroundColor": "#ff6347" 
        }
    ]
}