# ══════════════════════════════════════════════════════════════════════════
# Imagen de la API SECAD (ASP.NET Core 8).
#
# El código vive en Bakcend/backend/oftic/. La solución está en
# oftic/oftic.sln y referencia sus proyectos hermanos con rutas relativas
# (..\oftic.cl\Comun.csproj, etc. — los nombres de carpeta y de .csproj no
# coinciden: oftic.cl→Comun, oftic.dl→Datos, oftic.bl→Negocio,
# oftic.sl→Servicios), así que se copia el árbol completo tal cual para que
# esas rutas resuelvan sin reconstruirlas a mano.
# ══════════════════════════════════════════════════════════════════════════

# ── Etapa 1: compilación ──────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Bakcend/backend/oftic/ ./oftic/

WORKDIR /src/oftic/oftic
RUN dotnet restore oftic.sln
RUN dotnet publish Api.csproj -c Release -o /app/publish --no-restore

# ── Etapa 2: ejecución ────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# curl lo usa el HEALTHCHECK de aquí abajo y el del docker-compose.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Las subidas van a un volumen montado en /app/uploads; estas carpetas se
# crean para que el primer arranque no falle si el volumen viene vacío.
RUN mkdir -p /app/uploads/noticias \
             /app/uploads/sliders \
             /app/uploads/login \
             /app/uploads/videos \
             /app/uploads/modales

COPY --from=build /app/publish .

EXPOSE 8088

ENV ASPNETCORE_URLS=http://+:8088 \
    ASPNETCORE_ENVIRONMENT=Production \
    TZ=America/Bogota

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8088/api/health || exit 1

ENTRYPOINT ["dotnet", "Api.dll"]
