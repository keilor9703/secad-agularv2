# @policia/mfa (2FA institucional) está compilado contra Angular 20 y declara ese
# peer, pero este proyecto va en Angular 22. Se verificó que Angular 22 compila y
# type-checkea la librería sin problema (resuelve <pmfa-flow> y sus inputs), así
# que se acepta la resolución. Sin esto, un `npm ci` limpio falla con ERESOLVE.
# Quitar cuando la Policía publique la librería reconstruida contra Angular 22.
legacy-peer-deps=true
