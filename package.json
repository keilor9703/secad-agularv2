{
  "name": "policiadev-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "node scripts/postinstall.js",
    "check:a11y": "powershell -ExecutionPolicy Bypass -File ./check-accessibility.ps1"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@microsoft/signalr": "^8.0.29",
    "@policia/mfa": "file:dist-libs/policia-mfa-1.0.0.tgz",
    "@sweetalert2/ngx-sweetalert2": "15.0.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "flatpickr": "^4.6.13",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "ngx-editor": "^19.0.0-beta.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "11.26.25",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "semver": "^7.7.2",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
