# ══════════════════════════════════════════════════════════════════════════
#  Configuración del despliegue. Copiar a `.env` y completar.
#  El archivo `.env` NO va a git: contiene las claves reales.
# ══════════════════════════════════════════════════════════════════════════

# ── Volúmenes con datos ───────────────────────────────────────────────────
# ⚠ LO PRIMERO QUE HAY QUE MIRAR AL MIGRAR DESDE OTRO REPOSITORIO/CARPETA.
#
# Los tres Postgres y las subidas de archivos viven en volúmenes con nombre.
# Docker Compose les pone de prefijo el nombre del proyecto, así que al mover
# el stack cambiarían de nombre y el sistema arrancaría contra bases VACÍAS.
# Para que siga usando los datos que ya existen, mira cómo se llaman:
#
#     docker volume ls | grep -i secad
#
# y escribe aquí esos nombres EXACTOS. Si el stack anterior vivía en una
# carpeta llamada `secad_angular`, lo habitual es que sean:
#
#VOL_PGDATA=secad_angular_pgdata
#VOL_PGDATA_CALI=secad_angular_pgdata_cali
#VOL_PGDATA_BOGOTA=secad_angular_pgdata_bogota
#VOL_UPLOADS=secad_angular_uploads
#
# En un servidor nuevo, sin datos previos, déjalos comentados: se crean solos
# como secad_pgdata, secad_pgdata_cali, secad_pgdata_bogota y secad_uploads.

# ── Base maestra (PostgreSQL) ─────────────────────────────────────────────
# El compose levanta este contenedor y arma con estos datos la cadena
# ConnectionStrings:MasterDb. Aquí viven el registro de tenants
# (secad_tenants) y el enrutamiento a la base de cada CAD.
# Si reutilizas un volumen existente, las credenciales tienen que ser las
# MISMAS con las que se creó: Postgres solo inicializa la base la primera vez.
POSTGRES_DB=Secad
POSTGRES_USER=secad_app
POSTGRES_PASSWORD=

# ── Postgres del tenant Cali ──────────────────────────────────────────────
POSTGRES_CALI_DB=Secad_Cali
POSTGRES_CALI_USER=secad_cali_app
POSTGRES_CALI_PASSWORD=

# ── Postgres del tenant 11001 (CAD Bogotá D.C.) ───────────────────────────
POSTGRES_BOGOTA_DB=Secad_Bogota
POSTGRES_BOGOTA_USER=secad_bogota_app
POSTGRES_BOGOTA_PASSWORD=

# ── Claves ────────────────────────────────────────────────────────────────
# Firma de los JWT. Reemplaza el marcador de posición de appsettings.json
# ("CAMBIAR_EN_PRODUCCION…"). Mínimo 32 caracteres aleatorios.
# Cambiarla cierra la sesión de todos los usuarios conectados.
JWT_KEY=

# La que deben enviar los sistemas externos (PlantaTel/Chat/SMS) en la
# cabecera X-Api-Key. También es un marcador en appsettings.json.
RECEPCION_EXTERNA_API_KEY=

# ── Dominio público ───────────────────────────────────────────────────────
# Con esquema y sin barra final. Arma el enlace .../video/{token} que se le
# envía al ciudadano, así que tiene que ser accesible por HTTPS desde su
# teléfono: el navegador exige contexto seguro para abrir la cámara.
SECAD_BASE_URL=https://secad.midominio.com

# El proveedor de SMS que envía ese enlace se configura DENTRO de la
# aplicación (Administración → Proveedor SMS), no aquí.

# ── Puertos publicados en el HOST ─────────────────────────────────────────
# Solo importan si algo más en el servidor ya los usa.
FRONTEND_PORT=80
API_PORT=8088

# ── Red del proxy que publica el dominio ──────────────────────────────────
# Red externa, ya existente, del nginx compartido que hace de proxy inverso
# hacia el contenedor `secad-frontend`. Si en tu servidor no hay tal proxy,
# quita `proxy-externa` del servicio `frontend` y del bloque `networks:` del
# docker-compose.yml.
#RED_PROXY_EXTERNA=falcon-deploy_default

# ── pgAdmin — consola de la base de datos (opcional) ──────────────────────
# El servicio `pgadmin` no arranca con el sistema: lleva un `profile`. Para
# levantarlo cuando haga falta:
#
#     docker compose --profile herramientas up -d pgadmin
#
# El puerto se publica solo en 127.0.0.1, así que desde tu equipo se llega por
# un túnel SSH:  ssh -L 5050:localhost:5050 usuario@<ip>  → http://localhost:5050
#
# Estas son las credenciales para entrar A PGADMIN (no las de Postgres, que
# las pide al conectar a cada servidor).
PGADMIN_EMAIL=admin@secad.local
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ── TURN (videollamada) ───────────────────────────────────────────────────
# coturn NO forma parte de este stack: corre aparte en el servidor y hay que
# dejarlo en pie. La API firma credenciales EFÍMERAS con un secreto que
# comparte con coturn (`use-auth-secret`), así que ya NO hay usuario ni
# contraseña escritos en el JavaScript: ver docs/turn-coturn.md.
#
# Direcciones del servidor, separadas por coma. Vacío = solo STUN.
#TURN_URLS=turn:turn.midominio.com:3478?transport=udp,turn:turn.midominio.com:3478?transport=tcp
# El MISMO valor que `static-auth-secret` en turnserver.conf. Genérelo con:
#     openssl rand -base64 32
#TURN_SECRET=
# Cuánto dura cada credencial, en segundos (60 a 86400). Una llamada que dure
# más que esto pierde el relevo, así que no lo ponga por debajo de lo que dura
# la llamada más larga que espere.
#TURN_TTL_SECONDS=3600

# ── Claves que hoy conservan el marcador del repositorio ──────────────────
# Cifra las llaves de API que se guardan en el Hub de Integraciones. 32 bytes
# en base64:   openssl rand -base64 32
# Cambiarla DESPUÉS de haber emitido llaves hace que el botón «Ver» deje de
# poder descifrarlas (la autenticación no se afecta: usa la huella).
#API_KEYS_CLAVE_CIFRADO=

# Cuando todas las claves de arriba (JWT_KEY, RECEPCION_EXTERNA_API_KEY,
# API_KEYS_CLAVE_CIFRADO, y TURN_SECRET si usa TURN) tengan su valor real, ponga
# esto en true: la API se negará a arrancar si alguna conserva el marcador.
# Mientras tanto, cada arranque deja un aviso por clave en `docker compose logs api`.
#EXIGIR_SECRETOS=false
