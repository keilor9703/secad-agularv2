<!-- Arnés del driver genérico por RTSP. Igual que PtzIntegracion, fuera de la
     solución a propósito: se corre a mano y no debe alargar el build del API. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OnvifRtspIntegracion</RootNamespace>
    <AssemblyName>OnvifRtspIntegracion</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../oftic.cl/Comun.csproj" />
    <ProjectReference Include="../../oftic.sl/Servicios.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
  </ItemGroup>
</Project>
