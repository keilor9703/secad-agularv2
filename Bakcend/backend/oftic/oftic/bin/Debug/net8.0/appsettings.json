    "ClavePip": "HWV9Dq8N!*_X%zU%juz*",
    "PostPipToken": "https://internalpip.policia.gov.co:8080/api/Cuenta/Token",
    "OudLogin": "https://internalpip.policia.gov.co:8080/api/Oud/LoginOud",
    "ConsultaFuncionarios": "https://internalpip.policia.gov.co:8080/api/Icahu/FuncionarioPorIdentificacion?_identificacion=",
